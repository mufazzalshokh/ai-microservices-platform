# Local development only. Choose a database password before starting services.
POSTGRES_USER=appuser
POSTGRES_PASSWORD=changeme
POSTGRES_DB=aiplatform
POSTGRES_HOST=postgres

# Generate with: python scripts/generate_keys.py
JWT_PRIVATE_KEY_PATH=./keys/jwt-private.pem
JWT_PUBLIC_KEY_PATH=./keys/jwt-public.pem
JWT_ALGORITHM=RS256
JWT_ISSUER=http://localhost
JWT_AUDIENCE=ai-platform
MCP_RESOURCE_URL=http://localhost/mcp

# On Linux, use your host UID/GID so the issuer can read its 0600 key.
LOCAL_UID=1000
LOCAL_GID=1000

OPENAI_API_KEY=replace-with-your-provider-key
LLM_MODEL=gpt-4o-mini
AGENT_MODEL=gpt-4o-mini
LOG_LEVEL=INFO
